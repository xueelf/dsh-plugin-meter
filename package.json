{
  "name": "dsh-plugin-meter",
  "version": "0.1.0",
  "description": "Provider-aware cost and quota meter for DeepSeek Harness (dsh). Shows the session's estimated API cost below the composer and the selected provider's balance or quota.",
  "keywords": [
    "balance",
    "cordis",
    "cost",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "meter",
    "plugin",
    "quota",
    "usage"
  ],
  "homepage": "https://github.com/xueelf/dsh-plugin-meter#readme",
  "bugs": {
    "url": "https://github.com/xueelf/dsh-plugin-meter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/dsh-plugin-meter.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepack": "bun run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "annal": "^0.2.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "prettier-plugin-sort": "^1.1.2",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
